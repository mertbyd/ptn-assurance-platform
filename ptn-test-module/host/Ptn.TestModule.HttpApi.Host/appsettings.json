{
  "App": {
    "SelfUrl": "https://localhost:44366",
    "CorsOrigins": "http://localhost:3000,http://localhost:4200"
  },
  "AuthServer": {
    "Authority": "https://localhost:44323",
    "Audience": "TestModule",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "TestModule_Swagger"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ptn_test_module;Username=postgres;Password=postgres;"
  },
  "Redis": {
    "IsEnabled": false,
    "Configuration": "127.0.0.1"
  },
  // Kosum ihracat artefaktlari ve HAR govdeleri bu kokte saklanir; bos birakilirsa ContentRoot altindaki "blobs" kullanilir.
  "BlobStoring": {
    "FileSystemBasePath": ""
  },
  // Vault token'i bu dosyaya yazilmaz; yerel gelistirmede user-secrets veya TokenFile kullanilir.
  // Production ortaminda token yerine AgentProxy authentication modu secilir.
  "Vault": {
    "Address": "http://127.0.0.1:8200",
    "Mount": "pintern-dev",
    "AuthenticationMode": "Token",
    "RequestTimeoutSeconds": 10
  },
  // Yerel gelistirmede host kendi test_* semasini kurar ve lookup verisini uretir.
  // Production'da ikisi de ortam degiskeniyle kapatilir; sema goc sorumlulugu migrator'dadir.
  // EnsureSharedAbpSchema, paylasilan abp semasinin Authenticator tarafindan kuruldugunun beyanidir (RULE-0002).
  "Database": {
    "AutoMigrate": true,
    "SeedOnStartup": true,
    "EnsureSharedAbpSchema": true
  },
  // Makine istemcisine verilecek izinler; client-credentials token'inin kullanicisi olmadigi icin
  // yetki ABP'nin "C" saglayicisiyla client_id uzerinden okunur. Liste bos birakilabilir.
  "AgentClients": {
    "Registrations": []
  },
  // Yonetici rollerine verilecek izinler. Authenticator seed'i yalniz kendi hostunda tanimli izinleri
  // dagitir; bu modulun izinleri burada yuklendigi icin grant'i da bu host yazar.
  "RolePermissions": {
    "Registrations": [
      {
        "RoleName": "SuperAdmin",
        "Permissions": [
          "ApiContractChecker.Sources", "ApiContractChecker.Sources.View", "ApiContractChecker.Sources.Manage",
          "ApiContractChecker.Checks", "ApiContractChecker.Checks.View", "ApiContractChecker.Checks.Execute",
          "ApiContractChecker.Conformance", "ApiContractChecker.Conformance.Execute", "ApiContractChecker.Conformance.GenerateSamples", "ApiContractChecker.Conformance.SuggestLinks",
          "ApiContractChecker.Diagnosis", "ApiContractChecker.Diagnosis.Execute",
          "ApiContractChecker.Lookups", "ApiContractChecker.Lookups.View", "ApiContractChecker.Lookups.Manage",
          "DatabaseChecker.Connections", "DatabaseChecker.Connections.View", "DatabaseChecker.Connections.Manage",
          "DatabaseChecker.Definitions", "DatabaseChecker.Definitions.View", "DatabaseChecker.Definitions.Manage",
          "DatabaseChecker.Runs", "DatabaseChecker.Runs.View", "DatabaseChecker.Runs.Create",
          "DatabaseChecker.Lookups", "DatabaseChecker.Lookups.View", "DatabaseChecker.Lookups.Manage",
          "DatabaseChecker.Assertions", "DatabaseChecker.Assertions.Execute", "DatabaseChecker.Assertions.ValidateDerivability",
          "DatabaseChecker.Capabilities", "DatabaseChecker.Capabilities.Probe", "DatabaseChecker.Capabilities.Capture",
          "DatabaseChecker.Diagnosis", "DatabaseChecker.Diagnosis.Execute", "DatabaseChecker.Projections", "DatabaseChecker.Projections.Execute",
          "TestModule.Scenarios", "TestModule.Scenarios.Create", "TestModule.Scenarios.Update", "TestModule.Scenarios.Delete", "TestModule.Scenarios.Publish", "TestModule.Scenarios.Approve", "TestModule.Scenarios.Quarantine", "TestModule.Scenarios.Schedule",
          "TestModule.Runs", "TestModule.Runs.View", "TestModule.Runs.Trigger", "TestModule.Runs.Start", "TestModule.Runs.WriteResult", "TestModule.Runs.Export", "TestModule.Runs.Cancel", "TestModule.Runs.SandboxReset", "TestModule.Runs.ManageEnvironments",
          "TestModule.Lookups",
          "TestModule.Bridge", "TestModule.Bridge.Ground", "TestModule.Bridge.Explain", "TestModule.Bridge.Validate", "TestModule.Bridge.Knowledge", "TestModule.Bridge.Footprint", "TestModule.Bridge.Profile", "TestModule.Bridge.Task", "TestModule.Bridge.PatchSuggest", "TestModule.Bridge.Invariant", "TestModule.Bridge.ManageSources",
          "Piton.Emailing.EmailTemplates", "Piton.Emailing.EmailTemplates.Manage",
          "Piton.Emailing.Provider", "Piton.Emailing.Provider.View", "Piton.Emailing.Provider.Manage"
        ]
      }
    ]
  },
  "Piton": {
    "Emailing": {
      "Provider": "GmailOAuth2",
      "FromAddress": "",
      "FromDisplayName": "PTN Assurance",
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 587,
      "SmtpSecurity": "StartTls",
      "GoogleClientId": "",
      "GoogleRedirectUri": "https://localhost:44366/api/emailing/platform/google/callback",
      "SecretPath": "platform/email"
    }
  },
  "EntityFrameworkCore": {
    "Schemas": {
      "Volo.Abp.Identity": "abp",
      "Volo.Abp.PermissionManagement": "abp",
      "Volo.Abp.SettingManagement": "abp",
      "Volo.Abp.AuditLogging": "abp",
      "Volo.Abp.BackgroundJobs": "abp",
      "Volo.Abp.FeatureManagement": "abp",
      "Volo.Abp.TenantManagement": "abp",
      "Volo.Abp.OpenIddict": "openiddict",
      "Piton.Emailing": "email",

      "Ptn.ApiContractChecker": "checker",
      "Ptn.ApiContractChecker.Operators": "operator",
      "Ptn.ApiContractChecker.Email": "email",

      "Ptn.DatabaseChecker.Lookups": "lookup",
      "Ptn.DatabaseChecker.Connections": "connection",
      "Ptn.DatabaseChecker.Definitions": "definition",
      "Ptn.DatabaseChecker.Runs": "run",
      "Ptn.DatabaseChecker.Operators": "operator",
      "Ptn.DatabaseChecker.Comparison": "comparison",
      "Ptn.DatabaseChecker.Email": "email",

      "Ptn.TestModule.Lookup": "test_lookup",
      "Ptn.TestModule.Catalog": "test_catalog",
      "Ptn.TestModule.Run": "test_run"
    }
  },
  "SpecFetch": {
    "MaxContentSizeBytes": 10485760,
    "AllowedMediaTypes": [
      "application/json",
      "application/vnd.oai.openapi+json",
      "application/yaml",
      "application/x-yaml",
      "text/yaml",
      "text/x-yaml",
      "text/plain"
    ]
  },
  "SpecMonitoring": {
    "WorkerPeriodSeconds": 60,
    "MaxDocumentsPerTick": 50
  }
}
