<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Ptn.TestModule</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Ptn.TestModule-c2d31439-b723-48e2-b061-5ebd7aeb6010</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Composition host: yetenek paketleri burada bir kez compose edilir.
       Checker'lar tek DependsOn noktasi olan composition paketleriyle gelir (ADR-0002),
       Notifications tek bildirim owner'idir, Emailing ortak email sozlesmesinin sahibidir. -->
  <ItemGroup>
    <PackageReference Include="CheckNexus.ApiContracts" Version="$(CheckNexusApiContractsVersion)" />
    <PackageReference Include="CheckNexus.DatabaseComparison" Version="$(CheckNexusDatabaseComparisonVersion)" />
    <PackageReference Include="CheckNexus.Vault" Version="$(CheckNexusVaultVersion)" />
    <PackageReference Include="Pintern.SaaS.Notifications.HttpApi" Version="$(NotificationsVersion)" />
    <PackageReference Include="Piton.Emailing.Application" Version="$(PitonEmailingVersion)" />
    <PackageReference Include="Piton.Emailing.HttpApi" Version="$(PitonEmailingVersion)" />
    <PackageReference Include="Piton.Emailing.Infrastructure" Version="$(PitonEmailingVersion)" />
    <PackageReference Include="SystemStandards.AspNetCore" Version="$(SystemStandardsAspNetCoreVersion)" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

  <!-- Yazarlik malzemesi tek kaynaktir: assembly'ye gomulmez, content root altindan okunur ve uctan degistirilir. -->
  <ItemGroup>
    <Content Include="Authoring\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="$(SerilogAspNetCoreVersion)" />
    <PackageReference Include="Serilog.Sinks.Async" Version="$(SerilogSinksAsyncVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="$(MicrosoftEntityFrameworkCoreVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Authentication.JwtBearer" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.BlobStoring.FileSystem" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="$(AbpVersion)" />
    <!-- Ayar yonetimi uclarini acan tek eksik paket; diger bes SettingManagement paketi Authenticator uzerinden transitif gelir. -->
    <PackageReference Include="Volo.Abp.SettingManagement.HttpApi" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ptn.TestModule.HttpApi\Ptn.TestModule.HttpApi.csproj" />
    <ProjectReference Include="..\..\src\Ptn.TestModule.Application\Ptn.TestModule.Application.csproj" />
    <ProjectReference Include="..\..\src\Ptn.TestModule.EntityFrameworkCore\Ptn.TestModule.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Ptn.TestModule.Host.Shared\Ptn.TestModule.Host.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

</Project>
