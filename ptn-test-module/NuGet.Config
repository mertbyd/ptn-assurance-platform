<?xml version="1.0" encoding="utf-8"?>
<!--
  Tum bagimliliklar nuget.org'dan gelir. Bir gelistiricinin makinesine sabitlenmis
  local klasor kaynagi EKLENMEZ; temiz bir klonda o yol bulunmadigi icin restore kirilir.
  (Ayni gerekce checkers/api-contract/NuGet.Config dosyasinda kayitlidir.)

  packageSourceMapping: hangi paket adinin hangi kaynaktan cozulecegini acikca yazar.
  Tek kaynak varken islevi savunmadir: ileride ikinci bir kaynak (ozel feed, mirror)
  eklenirse esleme burada tanimli olur ve "dependency confusion" saldirisi engellenir.

  KAPANDI (2026-08-16): Pintern.SaaS.Notifications.* 0.1.0-alpha.1 paketleri
  SystemStandards.Abp.Authorization 1.0.0'a bagimlidir. nuget.org'a 1.0.0 degil
  2.1.0 yayimlandi; NuGet bagimlilik surumunu ALT SINIR olarak okudugu icin
  (>= 1.0.0) 2.1.0'a yuvarlanir ve temiz klonda restore calisir. Geride NU1603
  uyarisi kalir; bu uyari beklenendir, hata degildir.
  Bunun sonucu olarak tum SystemStandards ailesi 2.1.0'a hizalandi: Authorization
  2.1.0 -> SystemStandards.Abp 2.1.0 -> AspNetCore/Validation 2.1.0 -> Core 2.1.0
  zinciri, common.props icindeki eski 2.0.0/2.0.2 sabitleriyle NU1605 (surum
  dusurme) hatasi uretiyordu. Surumler common.props'ta tek yerden yonetilir.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
