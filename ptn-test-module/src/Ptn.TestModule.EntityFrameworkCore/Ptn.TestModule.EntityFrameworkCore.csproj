<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Ptn.TestModule</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Authenticator.EntityFrameworkCore" Version="$(AuthenticatorVersion)" />
    <!-- Secret deposu sozlesmesi provider katmaninda kalir; Application checker Domain paketine bagimli olmaz. -->
    <PackageReference Include="CheckNexus.ApiContracts.Domain" Version="$(CheckNexusApiContractsVersion)" />
    <PackageReference Include="Pintern.SaaS.Notifications.EntityFrameworkCore" Version="$(NotificationsVersion)" />
  </ItemGroup>

  <!-- Checker sozlesmeleri: Test Module checker'lara DOGRUDAN CAGRI ile soru sorar (ADR-0015 §F).
       Adapter'lar bu projenin Adapters/ klasorunde yasar; yeni proje veya katman acilmaz.
       Checker tablosuna FK verilmez, ortak transaction acilmaz. -->
  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="$(EfCoreNamingConventionsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="$(MicrosoftEntityFrameworkCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="$(AbpVersion)" />
    <ProjectReference Include="..\Ptn.TestModule.Domain\Ptn.TestModule.Domain.csproj" />
  </ItemGroup>

</Project>
