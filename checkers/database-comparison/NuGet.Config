<?xml version="1.0" encoding="utf-8"?>
<!--
  Tum bagimliliklar nuget.org'dan gelir.

  Daha once burada bir gelistiricinin makinesine sabitlenmis local klasor
  kaynagi vardi (C:\Users\...\RiderProjects\...). Temiz bir klonda o yol
  bulunmadigi icin restore "SystemStandards.Abp >= 2.0.2 bulunamadi" ile
  patliyordu. Ic paketler (Piton.Emailing.*, SystemStandards.Abp) 2026-07-23'te
  nuget.org'a yayinlandi; local kaynak artik GEREKMIYOR, geri eklemeyin.

  packageSourceMapping: hangi paket adinin hangi kaynaktan cozulecegini acikca
  yazar. Tek kaynak varken islevi savunmadir: ileride ikinci bir kaynak (ozel
  feed, mirror) eklenirse esleme burada tanimli olur ve "dependency confusion"
  saldirisi (ayni isimli sahte bir paketin baska kaynaktan gelmesi) engellenir.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
