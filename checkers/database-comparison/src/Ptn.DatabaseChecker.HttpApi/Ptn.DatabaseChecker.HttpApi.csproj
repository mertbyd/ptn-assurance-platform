    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.3.0" />
    <ProjectReference Include="..\Ptn.DatabaseChecker.Application.Contracts\Ptn.DatabaseChecker.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\Lookups\" />
  </ItemGroup>

  <ItemGroup>
