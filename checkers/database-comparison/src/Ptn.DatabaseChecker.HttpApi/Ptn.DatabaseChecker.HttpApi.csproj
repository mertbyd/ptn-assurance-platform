    <Nullable>enable</Nullable>
    <RootNamespace>Ptn.DatabaseChecker</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CheckNexus.DatabaseComparison.HttpApi</PackageId>
