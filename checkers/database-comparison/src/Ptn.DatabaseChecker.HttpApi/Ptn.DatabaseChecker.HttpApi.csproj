  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Controllers\Search\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Controllers\Search\**" />
  </ItemGroup>

</Project>
