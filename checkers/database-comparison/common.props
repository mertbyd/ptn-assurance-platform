<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0-alpha.9</Version>
    <Authors>CheckNexus</Authors>
    <Company>CheckNexus</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://pitea.piton.com.tr/PITON/ptn-database-checker-api.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://piton.com.tr/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>checknexus abp database comparison schema testing</PackageTags>
    <Copyright>Copyright © 2026 CheckNexus</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0-alpha.7</PackageValidationBaselineVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PtnSourceRepositoryMetadataAvailable Condition="'$(CI)' == 'true'">true</PtnSourceRepositoryMetadataAvailable>
    <PtnSourceRepositoryMetadataAvailable Condition="'$(PtnSourceRepositoryMetadataAvailable)' == ''">false</PtnSourceRepositoryMetadataAvailable>
    <EnableSourceControlManagerQueries Condition="'$(PtnSourceRepositoryMetadataAvailable)' != 'true'">false</EnableSourceControlManagerQueries>
    <EnableSourceLink Condition="'$(PtnSourceRepositoryMetadataAvailable)' != 'true'">false</EnableSourceLink>
    <EmbedUntrackedSources Condition="'$(PtnSourceRepositoryMetadataAvailable)' == 'true'">true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AbpProjectType>module</AbpProjectType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)PACKAGE-README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="ConfigureAwait.Fody" Version="3.3.1" PrivateAssets="All" />
    <PackageReference Include="Fody" Version="6.5.3">
      <PrivateAssets>All</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.AzureRepos.Git" Version="10.0.203" PrivateAssets="All" />
  </ItemGroup>


  <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
    <PropertyGroup>
      <NoWarn>$(NoWarn);0436</NoWarn>
    </PropertyGroup>
  </Target>

</Project>
