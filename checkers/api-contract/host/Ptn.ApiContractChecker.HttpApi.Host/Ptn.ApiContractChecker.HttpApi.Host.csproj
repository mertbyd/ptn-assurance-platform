    <Nullable>enable</Nullable>
    <RootNamespace>Ptn.ApiContractChecker</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Ptn.ApiContractChecker-c2d31439-b723-48e2-b061-5ebd7aeb6010</UserSecretsId>
