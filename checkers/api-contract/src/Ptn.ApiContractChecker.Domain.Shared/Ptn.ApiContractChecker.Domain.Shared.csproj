<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Ptn.ApiContractChecker</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <PackageId>CheckNexus.ApiContracts.Domain.Shared</PackageId>
    <Description>Shared contracts, permissions, localization, and constants for the CheckNexus API Contract Checker module.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain.Shared" Version="10.3.0" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\ApiContractChecker\*.json" />
    <Content Remove="Localization\ApiContractChecker\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Constants\Lookups\" />
  </ItemGroup>

</Project>
