<?xml version="1.0" encoding="utf-8"?>
<!--
  Depo koku: tum bagimliliklar nuget.org'dan gelir.

  Daha once burada kimlik bilgisi gomulu bir Nexus kaynagi vardi. Kaldirildi:
  ptn-test-module, checkers/api-contract, checkers/database-comparison ve vault
  proje kumelerinin dordu de yalniz nuget.org'a bakan bir config ile temiz odada
  restore edildi; hicbiri Nexus'a ihtiyac duymuyor. Duz metin parolanin depoda
  durmasi ise baska bir makineye klonlanan her kopyaya sizmasi demekti.

  Nexus ileride yeniden gerekirse kaynagi buraya ekleyin ama kimlik bilgisini
  dosyaya YAZMAYIN; kullanici seviyesi NuGet.Config veya ortam degiskeni kullanin.

  packageSourceMapping: hangi paket adinin hangi kaynaktan cozulecegini acikca yazar.
  Tek kaynak varken islevi savunmadir: ileride ikinci bir kaynak (ozel feed, mirror)
  eklenirse esleme burada tanimli olur ve "dependency confusion" saldirisi engellenir.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
