<?xml version="1.0" encoding="utf-8"?>
<!--
  Tum bagimliliklar nuget.org'dan gelir. Bu dosya olmadan vault/ kendi klasorunde
  bir NuGet.Config bulamayip depo kokundeki config'e dusuyordu; o config kimlik
  bilgisi gomulu bir Nexus kaynagi tasir ve baska bir makinede restore'u o kaynaga
  bagimli hale getirir. Kardes modullerin (checkers/*, ptn-test-module) config'leri
  ile ayni sekildedir.

  packageSourceMapping: hangi paket adinin hangi kaynaktan cozulecegini acikca yazar.
  Tek kaynak varken islevi savunmadir: ileride ikinci bir kaynak (ozel feed, mirror)
  eklenirse esleme burada tanimli olur ve "dependency confusion" saldirisi engellenir.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
