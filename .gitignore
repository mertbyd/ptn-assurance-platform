# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
.vs/

# Packaging output, local NuGet feed and consumer-smoke NuGet caches.
# These are reproducible from source and include vendored third-party packages.
artifacts/

# IDE state
.idea/
*.user
*.suo

# Local scratch output (generated PDFs, temporary exports). Reproducible, never shared.
output/
tmp/

# This repository tracks SOURCE CODE only. The wiki vault, the release/publish
# scripts and the agent instruction documents stay local: they are not part of
# the shipped product and they are not reviewed as code. Root README.md is the
# only prose kept under version control. The wiki lives in the GitHub wiki.
docs/
scripts/
AGENTS.md
CLAUDE.md

# Obsidian per-user pane/layout state. The shared vault config
# (app.json, appearance.json, core-plugins.json, graph.json) stays tracked.
**/.obsidian/workspace.json

# The two checker modules are INDEPENDENT Git repositories with their own
# imported upstream history, their own branches and their own release tags:
#
#   checkers/api-contract          -> ptn-contract-checker-api  (KBP-6xx)
#   checkers/database-comparison   -> ptn-database-checker-api  (KBP-7xx)
#
# They are deliberately not tracked here and deliberately not submodules:
# their only upstreams are local worktree paths, so a submodule reference
# would not resolve on any other machine. Each module documents its own
# provenance in its PROVENANCE.md.
checkers/

# The shared Vault module ships as the CheckNexus.Vault NuGet package and is
# consumed here through a PackageReference, never a ProjectReference. Its
# source is not part of this repository's build.
vault/
