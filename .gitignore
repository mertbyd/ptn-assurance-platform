# Bu depo, devir sonrasi TEK kaynaktir. Checker modulleri, Vault modulu, wiki
# (docs/), yayin scriptleri ve ajan sozlesmeleri (AGENTS.md, CLAUDE.md) artik
# burada izlenir. Daha once bunlar bilerek disarida birakiliyordu; o kararlar
# 2026-08-16'da geri alindi cunku checker'larin tek upstream'i bu makinedeki
# yerel worktree yollariydi ve wiki deposunun hic remote'u yoktu.
#
# Asagida kalan tek kategori URETILEBILIR CIKTIDIR: kaynaktan yeniden uretilir,
# surumlenmesi anlamsizdir ve depoyu yuzlerce MB sisirir.

# Derleme ciktisi
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
.vs/

# Paketleme ciktisi ve yerel NuGet feed'i (~600 MB). Icinde vendor edilmis
# ucuncu parti paketler var; hepsi scripts/publish-checkers.ps1 ile yeniden
# uretilir.
artifacts/

# Node bagimliliklari (ptn-test-agent). pnpm-lock.yaml izlenir, modul agaci izlenmez.
node_modules/

# IDE durumu
.idea/
*.user
*.suo

# Yerel gecici cikti (uretilen PDF'ler, wiki yedekleri, disa aktarmalar).
output/
tmp/

# Obsidian'in kullaniciya ozel panel/duzen durumu. Paylasilan vault ayarlari
# (app.json, appearance.json, core-plugins.json, graph.json) izlenmeye devam eder.
**/.obsidian/workspace.json
